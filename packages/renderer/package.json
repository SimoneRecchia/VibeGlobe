{
  "name": "@vibeglobe/renderer",
  "version": "0.0.0",
  "description": "VibeGlobe renderer: renderer backend: WebGPU with automatic WebGL2 fallback, shaders, GPU resource management.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./gltf": {
      "types": "./dist/gltf.d.ts",
      "source": "./src/gltf.ts",
      "default": "./dist/gltf.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "dependencies": {
    "@vibeglobe/core": "0.0.0",
    "earcut": "3.2.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0"
  }
}
