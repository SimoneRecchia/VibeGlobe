{
  "name": "@vibeglobe/core",
  "version": "0.0.0",
  "description": "VibeGlobe core: math, geodesy, camera, tiling, scheduling, cache and events.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./decoders": {
      "types": "./dist/decoders.d.ts",
      "source": "./src/decoders.ts",
      "default": "./dist/decoders.js"
    },
    "./geodesy": {
      "types": "./dist/geodesy.d.ts",
      "source": "./src/geodesy.ts",
      "default": "./dist/geodesy.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "!dist/tsconfig.tsbuildinfo",
    "!src/**/*.test.ts",
    "!src/**/__fixtures__",
    "!dist/**/__fixtures__"
  ]
}
