{
  "name": "@vibeglobe/vue",
  "version": "0.1.0",
  "description": "VibeGlobe vue: vue 3 adapter: components and composables, SSR-safe.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "!dist/tsconfig.tsbuildinfo",
    "!src/**/*.test.ts",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/fixtures/**/*.{json,txt,md,gz,tif,terrain}",
    "!dist/**/__fixtures__"
  ],
  "dependencies": {
    "@vibeglobe/controls": "0.1.0",
    "@vibeglobe/core": "0.1.0",
    "@vibeglobe/layers": "0.1.0",
    "@vibeglobe/quality": "0.1.0",
    "@vibeglobe/renderer": "0.1.0",
    "@vibeglobe/ui": "0.1.0",
    "@vibeglobe/worker": "0.1.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "3.5.44"
  }
}
