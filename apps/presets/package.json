{
  "name": "@vibeglobe/presets",
  "version": "0.1.0",
  "private": true,
  "description": "The playground's own maps: the Europe preset of free, redistributable sources (europeOpen). Not part of the published library (ADR 0187).",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./countries": {
      "types": "./dist/countries.d.ts",
      "source": "./src/countries.ts",
      "default": "./dist/countries.js"
    },
    "./orthophotos": {
      "types": "./dist/orthophotos.d.ts",
      "source": "./src/orthophotos.ts",
      "default": "./dist/orthophotos.js"
    },
    "./world-land": {
      "types": "./dist/world-land.d.ts",
      "source": "./src/world-land.ts",
      "default": "./dist/world-land.js"
    }
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@vibeglobe/core": "0.1.0",
    "@vibeglobe/sources": "0.1.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.4.4"
  }
}
