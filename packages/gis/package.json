{
  "name": "@vibeglobe/gis",
  "version": "0.1.0",
  "description": "VibeGlobe gis: coordinate parsing and formatting, reference-system transforms, geodesic measurement and view-state serialization.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "!dist/tsconfig.tsbuildinfo",
    "!src/**/*.test.ts",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/fixtures/**/*.{json,txt,md,gz,tif,terrain}",
    "!dist/**/__fixtures__"
  ],
  "dependencies": {
    "@vibeglobe/core": "0.1.0",
    "proj4": "2.22.0"
  }
}
