{
  "name": "@vibeglobe/renderer",
  "version": "0.0.0",
  "description": "VibeGlobe renderer: renderer backend: WebGPU with automatic WebGL2 fallback, shaders, GPU resource management.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./gltf": {
      "types": "./dist/gltf.d.ts",
      "source": "./src/gltf.ts",
      "default": "./dist/gltf.js"
    },
    "./vector-tiles": {
      "types": "./dist/vector-tiles/index.d.ts",
      "source": "./src/vector-tiles/index.ts",
      "default": "./dist/vector-tiles/index.js"
    },
    "./tiles3d": {
      "types": "./dist/tiles3d/index.d.ts",
      "source": "./src/tiles3d/index.ts",
      "default": "./dist/tiles3d/index.js"
    },
    "./starfield": {
      "types": "./dist/starfield/index.d.ts",
      "source": "./src/starfield/index.ts",
      "default": "./dist/starfield/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "!dist/tsconfig.tsbuildinfo",
    "!src/**/*.test.ts",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/fixtures/**/*.{json,txt,md,gz,tif,terrain}",
    "!dist/**/__fixtures__"
  ],
  "dependencies": {
    "@types/three": "0.186.0",
    "@vibeglobe/core": "0.0.0",
    "@vibeglobe/models": "0.0.0",
    "earcut": "3.2.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@vibeglobe/sources": "0.0.0"
  }
}
