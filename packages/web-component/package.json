{
  "name": "@vibeglobe/web-component",
  "version": "0.0.0",
  "description": "VibeGlobe web-component: framework-neutral <vibe-globe> custom element.",
  "license": "MPL-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./browser": "./dist/browser/vibe-globe.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "!dist/tsconfig.tsbuildinfo",
    "!src/**/*.test.ts",
    "!src/**/__fixtures__",
    "!src/**/__snapshots__",
    "!src/**/fixtures/**/*.{json,txt,md,gz,tif,terrain}",
    "!dist/**/__fixtures__"
  ],
  "dependencies": {
    "@vibeglobe/controls": "0.0.0",
    "@vibeglobe/core": "0.0.0",
    "@vibeglobe/renderer": "0.0.0",
    "@vibeglobe/sources": "0.0.0",
    "@vibeglobe/ui": "0.0.0",
    "@vibeglobe/worker": "0.0.0"
  },
  "scripts": {
    "build:browser": "vite build"
  }
}
