{
  "version": 8,
  "name": "VibeGlobe fixture streets",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["/vector-tiles/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "Fixture data (invented)"
    }
  },
  "sprite": "/vector-tiles/sprite",
  "glyphs": "/vector-tiles/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#a8cfe0"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "land"],
      "paint": {
        "fill-color": "#efe9de"
      }
    },
    {
      "id": "italy",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "country"],
      "paint": {
        "fill-color": "#f3e7cf",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "park"],
      "paint": {
        "fill-color": "#c8e6b0"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#8cc3e0"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#6aaed6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 6]
      }
    },
    {
      "id": "graticule",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "class"], "graticule"],
      "paint": {
        "line-color": "#7a8a99",
        "line-width": 1,
        "line-opacity": 0.6,
        "line-dasharray": [4, 2]
      }
    },
    {
      "id": "tunnel-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        ["==", ["geometry-type"], "LineString"],
        [
          "match",
          ["get", "class"],
          ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"],
          true,
          false
        ],
        ["==", ["get", "brunnel"], "tunnel"]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          ["get", "class"],
          "motorway",
          "#dc2a67",
          "trunk",
          "#c84e2f",
          "primary",
          "#a06b00",
          "secondary",
          "#707d05",
          "tertiary",
          "#8f8f8f",
          "minor",
          "#bbbbbb",
          "service",
          "#bbbbbb",
          "#ffffff"
        ],
        "line-width": 1.5,
        "line-gap-width": [
          "interpolate",
          ["exponential", 1.5],
          ["zoom"],
          6,
          [
            "match",
            ["get", "class"],
            "motorway",
            1,
            "trunk",
            1,
            "primary",
            0.5,
            "secondary",
            0.2,
            "tertiary",
            0.1,
            "minor",
            0,
            "service",
            0,
            1
