{
  "version": 8,
  "name": "VibeGlobe fixture: heatmap layers",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["/vector-tiles/tiles/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "Fixture data (invented)"
    }
  },
  "sprite": "/vector-tiles/sprite",
  "glyphs": "/vector-tiles/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#ffffff"
      }
    },
    {
      "id": "heat",
      "type": "heatmap",
      "source": "openmaptiles",
      "source-layer": "heat",
      "paint": {
        "heatmap-weight": ["/", ["get", "mag"], 5],
        "heatmap-radius": ["interpolate", ["linear"], ["zoom"], 10, 8, 15, 40],
        "heatmap-intensity": 1
      }
    }
  ]
}
