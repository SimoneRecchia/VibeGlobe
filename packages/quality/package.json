{
  "name": "@vibeglobe/quality",
  "version": "0.0.0",
  "description": "VibeGlobe quality: quality presets, capability-based start-up choice and the adaptive frame-time governor.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
