{
  "name": "@vibeglobe/sources",
  "version": "0.0.0",
  "description": "VibeGlobe sources: source adapters for imagery, terrain, vector and 3D data, with provider profiles.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "source": "./src/conformance/index.ts",
      "default": "./dist/conformance/index.js"
    },
    "./vector": {
      "types": "./dist/vector/index.d.ts",
      "source": "./src/vector/index.ts",
      "default": "./dist/vector/index.js"
    },
    "./mbtiles": {
      "types": "./dist/mbtiles.d.ts",
      "source": "./src/mbtiles.ts",
      "default": "./dist/mbtiles.js"
    },
    "./tiles3d": {
      "types": "./dist/tiles3d/index.d.ts",
      "source": "./src/tiles3d/index.ts",
      "default": "./dist/tiles3d/index.js"
    },
    "./geotiff": {
      "types": "./dist/geotiff.d.ts",
      "source": "./src/geotiff.ts",
      "default": "./dist/geotiff.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "dependencies": {
    "@vibeglobe/core": "0.0.0",
    "fflate": "0.8.3",
    "pbf": "5.1.2",
    "pmtiles": "4.5.0",
    "sql.js": "1.15.1",
    "txml": "6.0.3"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@types/sql.js": "1.4.11",
    "@vibeglobe/gis": "0.0.0"
  }
}
