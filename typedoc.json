{
  "$schema": "https://typedoc.org/schema.json",
  "name": "VibeGlobe",
  "entryPoints": [
    "packages/*/src/index.ts",
    "packages/core/src/decoders.ts",
    "packages/core/src/geodesy.ts",
    "packages/core/src/layers.ts",
    "packages/core/src/diagnostics.ts",
    "packages/ui/src/minimap.ts",
    "packages/layers/src/model-layer.ts"
  ],
  "tsconfig": "tsconfig.docs.json",
  "out": "docs-site",
  "readme": "README.md",
  "projectDocuments": ["docs/guides/*.md"],
  "excludePrivate": true,
  "treatWarningsAsErrors": true
}
