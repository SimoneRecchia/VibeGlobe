{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tools.tsbuildinfo"
  },
  "include": [
    "scripts",
    "benchmarks",
    "e2e",
    "vitest.config.ts",
    "playwright.config.ts",
    "apps/*/vite.config.ts",
    "eslint.config.ts"
  ],
  "exclude": ["scripts/fixtures"]
}
