{
  "name": "vibeglobeengine",
  "version": "0.0.0",
  "private": true,
  "description": "VibeGlobeEngine monorepo: an optimized, glitch-free web globe and map engine.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @vibeglobe/playground",
    "typecheck": "tsc -b",
    "dev": "npm run dev -w @vibeglobe/playground",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check.ts",
    "check:features": "node scripts/check-feature-list.ts",
    "check:tests": "node scripts/check-tests.ts",
    "deadcode": "knip && eslint .",
    "licenses": "node scripts/license-audit.ts",
    "notices": "node scripts/notices.ts",
    "size": "node scripts/bundle-size.ts",
    "treeshake": "node scripts/tree-shaking.ts",
    "bench": "node benchmarks/run.ts",
    "docs": "typedoc",
    "docs:serve": "vite preview --outDir docs-site --port 5174 --strictPort",
    "verify": "npm run build && npm run lint && npm run format:check && npm run check && npm run check:features && npm run check:tests && npm run deadcode && npm run licenses && npm run notices -- --check && npm run coverage && npm run check:consumer && npm run size && npm run treeshake && npm run docs",
    "status": "node scripts/status.ts",
    "check:consumer": "node scripts/check-consumer.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-playwright": "2.12.1",
    "happy-dom": "21.0.3",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
