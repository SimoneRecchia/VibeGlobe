{
  "name": "@vibeglobe/worker",
  "version": "0.0.0",
  "description": "VibeGlobe worker program: the single module worker that runs decoding tasks for the shared worker pool.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./vibeglobe-worker.js": {
      "source": "./src/vibeglobe-worker.ts",
      "default": "./dist/vibeglobe-worker.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "!dist/tsconfig.tsbuildinfo",
    "!src/**/*.test.ts",
    "!src/**/__fixtures__",
    "wasm/vibeglobe-basis.wasm",
    "wasm/meshopt-decoder.wasm",
    "wasm/licenses",
    "wasm/third-party.json",
    "!dist/**/__fixtures__"
  ],
  "dependencies": {
    "@vibeglobe/core": "0.0.0",
    "@vibeglobe/sources": "0.0.0",
    "@vibeglobe/layers": "0.0.0",
    "@vibeglobe/models": "0.0.0"
  }
}
